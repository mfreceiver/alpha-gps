<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.CameraGps" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/alpha_primary</item>
        <item name="android:windowBackground">@color/alpha_background</item>
    </style>

    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <!-- Use windowSplashScreenAnimatedIcon to add a drawable or an animated
             drawable. -->
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="windowSplashScreenBackground">@color/alpha_background</item>
        <!-- Set the theme of the Activity that follows your splash screen. -->
        <item name="postSplashScreenTheme">@style/Theme.CameraGps</item>
    </style>
</resources>
